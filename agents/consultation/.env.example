# ── Database ────────────────────────────────────────────────────────────────
# 상담 자기 자료(상담 이력·시나리오·메시지)만 담는 전용 DB.
#
# 수신 원장 DB 를 가리키면 안 된다. 수신 데이터는 core-banking 내부 API 로만 읽는다
# (CONSULTATION_CORE_BANKING_URL). 여기에 원장 DB 를 넣으면 감사도 인가도 없는
# 조회 경로가 되살아난다.
CONSULTATION_DATABASE_URL=postgresql+psycopg://consultation:consultation@localhost:5432/consultation

# ── Kafka ────────────────────────────────────────────────────────────────────
# Kafka 브로커 활성화 여부 (true: 실제 발행 / false: 무시, 로컬 개발용)
CONSULTATION_KAFKA_ENABLED=true
CONSULTATION_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CONSULTATION_KAFKA_TOPIC_CHATBOT_EVENTS=consultation.chatbot.events
CONSULTATION_KAFKA_TOPIC_CHAT_EVENTS=consultation.chat.events

# ── LLM ─────────────────────────────────────────────────────────────────────
CONSULTATION_LLM_CONFIDENCE_THRESHOLD=70
# OpenAI API 키 (필수) — https://platform.openai.com/api-keys 에서 발급
CONSULTATION_OPENAI_API_KEY=
