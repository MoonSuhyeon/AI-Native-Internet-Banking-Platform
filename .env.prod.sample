# =============================================================================
# 운영 환경변수 템플릿 — .env.prod 를 만들어 Oracle 서버에 두고 절대 커밋 금지
#
# 사용:
#   cp .env.prod.sample .env.prod
#   vi .env.prod    # 실제 값 채우기
#   scp .env.prod  ubuntu@<oracle-ip>:~/app/.env.prod   # 1회 전송
# =============================================================================

# ── GHCR 이미지 ──────────────────────────────────────────────────────────
# GitHub 사용자/조직명. **반드시 소문자로 적는다** (예: fast-campus-reboot-campus).
#
# 계정 이름에 대문자가 있어도 그대로 쓰면 안 된다. Docker 는 이미지 경로에
# 대문자를 허용하지 않아 pull 이 이렇게 끝난다:
#
#   invalid reference format: repository name (...) must be lowercase
#
# CI 는 이미 ${GITHUB_REPOSITORY_OWNER,,} 로 소문자로 바꿔 발행하고 있으므로
# (reusable-docker-publish.yml), 여기만 맞추면 된다.
GITHUB_OWNER=

# 이미지 태그 (기본 latest, CI/CD 에서 특정 SHA 로 덮어쓰기)
CUSTOMER_IMAGE_TAG=latest
DEPOSIT_IMAGE_TAG=latest
LOAN_IMAGE_TAG=latest
PAYMENT_IMAGE_TAG=latest
AI_IMAGE_TAG=latest
AUTO_REVIEW_IMAGE_TAG=latest
REVIEW_AIGW_IMAGE_TAG=latest
GATEWAY_IMAGE_TAG=latest
API_GATEWAY_IMAGE_TAG=latest
CONSULTATION_IMAGE_TAG=latest
DEPOSIT_API_IMAGE_TAG=latest
DATA_TOOLS_IMAGE_TAG=latest

# ── 외부 노출 포트 ────────────────────────────────────────────────────────
GATEWAY_PUBLIC_PORT=8080

# ── DB ────────────────────────────────────────────────────────────────────
CUSTOMER_DB_NAME=customer_db
CUSTOMER_DB_USER=customer
CUSTOMER_DB_PASSWORD=__CHANGE_ME__

# 수신(deposit)·결제(payment) 스키마를 한 DB 에 담는다 — docs/decisions/core-banking-merge.md
CORE_BANKING_DB_NAME=core_banking
CORE_BANKING_DB_USER=core
CORE_BANKING_DB_PASSWORD=__CHANGE_ME__

# 조사 에이전트 감사 저장소. 에이전트마다 자기 DB 를 갖는 구조라 따로 둔다
# (agents/*/sql/harness-audit.sql). 계정계 DB 에 얹으면 감사 기록이 원장 DB 의
# 백업·복구 정책에 묶여, 원장을 되돌릴 때 감사도 함께 되돌아간다.
FRAUD_AUDIT_DB_PASSWORD=__CHANGE_ME__

LOAN_DB_NAME=loan_db
LOAN_DB_USER=loan
LOAN_DB_PASSWORD=__CHANGE_ME__


AI_DB_NAME=ai_db
AI_DB_USER=ai
AI_DB_PASSWORD=__CHANGE_ME__

COMMON_DB_NAME=common_db
COMMON_DB_USER=common
COMMON_DB_PASSWORD=__CHANGE_ME__


# ── 인증/시크릿 ──────────────────────────────────────────────────────────
# 32자 이상 권장. openssl rand -base64 48 로 생성.
JWT_SECRET=__CHANGE_ME__internet-banking-jwt-secret-must-be-at-least-32-chars__
# 주민번호 AES 키. 미주입 시 레포에 적힌 개발용 기본값이 쓰이므로 암호화가 무의미해진다.
RRN_CRYPTO_KEY=__CHANGE_ME__rrn-aes-passphrase__
# 본인확인 CI 파생 시크릿.
IDENTITY_CI_SECRET=__CHANGE_ME__identity-ci-secret__

# ── 서비스 간 주소 ───────────────────────────────────────────────────────
# 챗봇 이체는 core-banking 을 거친다. 미지정 시 localhost 로 붙어 실패한다.
CONSULTATION_CORE_BANKING_URL=http://core-banking:8082

# ── 모니터링 ─────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__CHANGE_ME__

# ── 외부 API 키 (AI/RAG) ─────────────────────────────────────────────────
OPENAI_API_KEY=
VERTEX_AI_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json

# ── 공공데이터 (data-tools) ──────────────────────────────────────────────
KOREA_BANK_API_KEY=
KOSIS_API_KEY=
PUBLIC_DATA_API_KEY=
FISIS_API_KEY=

# ── 도메인 · HTTPS (Caddy) ───────────────────────────────────────────────
#
# Caddy 가 이 도메인으로 Let's Encrypt 인증서를 발급받는다.
# **DNS 가 실제로 이 서버를 가리킨 뒤에** 띄울 것 — 그 전에 올리면 검증이 실패하고,
# 반복 실패는 발급 한도(도메인당 주 5회)에 걸린다.
SITE_DOMAIN=example.com
# 인증서 만료·발급 실패 알림을 받을 주소. 비우면 알림이 갈 곳이 없다.
ACME_EMAIL=admin@example.com

# ── 프론트 이미지 태그 ───────────────────────────────────────────────────
WEB_IMAGE_TAG=latest

# ── 상담 사이드카 공유 시크릿 ────────────────────────────────────────────
#
# 게이트웨이와 상담 서비스가 나눠 갖는다. 비어 있으면 상담 서비스가
# **어떤 신원도 믿지 않아** 챗봇이 전부 401 이다. fail-closed 라 뚫리지는 않지만
# 값이 없다는 것도 알기 어렵다.
#   openssl rand -hex 24
CONSULTATION_GATEWAY_SHARED_SECRET=__CHANGE_ME__

# ── 에이전트 가명처리 소금 ───────────────────────────────────────────────
#
# 추적·로그로 나가는 식별자를 HMAC 으로 가명처리한다. 미설정이면 프로세스마다
# 가명이 달라져 재기동 후 같은 고객이 다른 가명이 된다.
#   openssl rand -hex 16
AGENT_PII_SALT=__CHANGE_ME__

# ── 공용 AES-256 키 ──────────────────────────────────────────────────────
#
# **없으면 customer-service 가 부팅에 실패한다.** crypto.key-base64 는 기본값도
# yml 항목도 없이 이 환경변수에만 의존한다(CryptoProperties — 미주입 시 바인딩
# 실패로 죽는 fail-fast 설계).
#
# 증상이 조용하지 않고 요란한 대신 엉뚱한 데를 보게 된다. 컨테이너는 계속
# 재시작하고, 로그 앞부분은 정상이라 Flyway 나 DB 를 의심하게 된다. 실제 원인은
# 이것 한 줄이다:
#
#   Error creating bean 'cryptoService' ... NullPointerException
#
#   openssl rand -base64 32
CRYPTO_KEY_BASE64=__CHANGE_ME__

# ── 상담 AI 에이전트 3종 ─────────────────────────────────────────────────
#
# **여기 없으면 셋 다 꺼진다.** 운영 compose 는 .env.prod 를 그대로 주입하고,
# 앱은 값이 "true" 일 때만 켠다 — 미설정은 곧 비활성이다.
#
# 로컬 compose 는 기본값을 갖고 있지만 운영은 이 파일이 전부라, 여기 빠지면
# 로컬에서는 되고 배포하면 조용히 안 되는 상태가 된다.
#
#   목표 달성 플래너  savings_goal.py         (LLM 사용 — OPENAI_API_KEY 없으면 계산만)
#   만기·재투자      maturity_agent.py       (순수 계산, LLM 미사용)
#   지출 패턴        spending_pattern_agent.py (순수 계산, LLM 미사용)
GOAL_AGENT_ENABLED=true
MATURITY_AGENT_ENABLED=true
SPENDING_AGENT_ENABLED=true

# ── 게이트웨이 속도제한 ──────────────────────────────────────────────────
#
# **application.yml 에 기본값이 없다. 하나라도 비면 게이트웨이가 기동하지 않는다.**
# 값 자체는 커밋된 .env.sample 이 정본이고 여기 옮겨 적은 것이다.
#
# replenish = 초당 허용, burst = 순간 허용. 로그인 경로를 낮게 잡는 이유는
# 자격증명 대입을 늦추기 위해서다.
GATEWAY_AUTH_REPLENISH_RATE=5
GATEWAY_AUTH_BURST_CAPACITY=10
GATEWAY_CUSTOMER_REPLENISH_RATE=20
GATEWAY_CUSTOMER_BURST_CAPACITY=40
GATEWAY_LOAN_REPLENISH_RATE=10
GATEWAY_LOAN_BURST_CAPACITY=20
GATEWAY_AUTO_REVIEW_REPLENISH_RATE=5
GATEWAY_AUTO_REVIEW_BURST_CAPACITY=10

# ── 게이트웨이 CORS ──────────────────────────────────────────────────────
#
# 브라우저가 붙이는 Origin 을 게이트웨이가 허용해야 한다. 배포 compose 가
# SITE_DOMAIN 으로 채우므로 보통은 비워 둔다. 다른 도메인에서도 부르게 하려면
# 쉼표로 이어 적는다(예: https://a.example.com,https://b.example.com).
#
# 비어 있으면 코드 기본값(localhost:3000/3001 등)만 허용되고, 배포 도메인에서는
# 로그인 같은 POST 가 403 으로 막힌다. GET 은 Origin 을 안 보내 401 로 보이기 때문에
# "로그인만 안 된다" 로 나타난다.
GATEWAY_CORS_EXTRA_ORIGIN=

# ── 조사 에이전트 사이드카 ───────────────────────────────────────────────
#
# 둘 다 기본값이 있어서 **서비스는 뜬다.** 그래서 빠진 것을 알아채기 어렵다.
#
#   FRAUD_GATEWAY_SHARED_SECRET   게이트웨이 → 조사 에이전트.
#                                 비면 어드민 조사 화면이 403 이고, 이체가 막힌
#                                 고객 안내가 조용히 기본형으로 내려간다.
#   FRAUD_DISPATCH_SHARED_SECRET  탐지기 → 조사 인계.
#                                 비면 탐지는 도는데 조사 큐가 영원히 빈다.
#
# 양쪽이 같은 값이어야 한다.
#   openssl rand -hex 24
FRAUD_GATEWAY_SHARED_SECRET=__CHANGE_ME__
FRAUD_DISPATCH_SHARED_SECRET=__CHANGE_ME__
