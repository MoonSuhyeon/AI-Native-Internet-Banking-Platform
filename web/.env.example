NEXT_PUBLIC_API_URL=http://localhost:8080
# 대출(loan-service) 전용. 게이트웨이 미경유 시 8083 직접.
NEXT_PUBLIC_LOAN_API_URL=http://localhost:8083
NEXT_PUBLIC_DEPOSIT_API_URL=http://localhost:8082/api
CONSULTATION_API_URL=http://localhost:8087
# 상담 서비스는 게이트웨이(NEXT_PUBLIC_API_URL)를 거쳐 부른다. 직접 주소를 두면
