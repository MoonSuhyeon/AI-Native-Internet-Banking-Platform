{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "rules": {
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "lib/loan-api.ts",
        "lib/ai-api.ts",
        "lib/advisory-api.ts",
        "app/**/loan/**/*.tsx",
        "app/**/loans/**/*.tsx",
        "app/**/ai/**/*.tsx"
      ],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off"
      }
    }
  ]
}
