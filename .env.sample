# ---- Spring ----
SPRING_PROFILES_ACTIVE=local
JPA_DDL_AUTO=update

# ---- Host Ports (외부 노출용. 충돌 시 변경) ----
CUSTOMER_DB_PORT=5432
CORE_BANKING_PORT_A=8082
CORE_BANKING_PORT_B=8180
CORE_BANKING_DB_PORT_A=5433
LOAN_DB_PORT=5434
AI_DB_PORT=5437
COMMON_DB_PORT=5438
LANGFUSE_DB_PORT=5439
CORE_BANKING_DB_PORT_B=5441
REDIS_PORT=6379
KAFKA_PORT=9092
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9095
BLACKBOX_PORT=9115
WINDOWS_EXPORTER_PORT=9182
KAFKA_EXPORTER_KFTC_PORT=9308
KAFKA_EXPORTER_BOK_PORT=9309
KAFKA_EXPORTER_INTERNAL_PORT=9310

# ---- 게이트웨이 속도제한 (경로별) ----
# 값이 없으면 게이트웨이가 아예 뜨지 않는다. application.yml 이 기본값 없이
# ${...} 로만 참조하기 때문이고, 그건 "정책값을 코드에 두지 않는다" 는 의도다.
# 그래서 코드가 아니라 여기에 둔다.
#
# 아래는 **데모 값이며 운영 정책이 아니다.** 운영 수치는 트래픽·사고 이력을 보고
# 정해야 한다. replenish=초당 허용, burst=순간 허용.
GATEWAY_AUTH_REPLENISH_RATE=5
GATEWAY_AUTH_BURST_CAPACITY=10
GATEWAY_CUSTOMER_REPLENISH_RATE=20
GATEWAY_CUSTOMER_BURST_CAPACITY=40
GATEWAY_LOAN_REPLENISH_RATE=10
GATEWAY_LOAN_BURST_CAPACITY=20
GATEWAY_AUTO_REVIEW_REPLENISH_RATE=5
GATEWAY_AUTO_REVIEW_BURST_CAPACITY=10

# ---- 이상거래 사전점검(FDS) ----
# 이체 전에 탐지기를 부른다. 기본값이 false 라 켜지 않으면 FDS 경로가 통째로 돌지
# 않는다 — 데모에서 "의심 거래가 막히는" 장면이 안 나온다.
DEPOSIT_FDS_ENABLED=true

# ---- Service App Ports ----
GATEWAY_APP_PORT=8080
CUSTOMER_APP_PORT=8081
DEPOSIT_APP_PORT=8082
LOAN_APP_PORT=8083
CONSULTATION_APP_PORT=8087
AIGATEWAY_APP_PORT=8088
AUTO_LOAN_REVIEW_APP_PORT=8089
# 서류 에이전트(doc 프로필). 예전 기본값이 8087 이라 consultation 과 충돌했다.
DOC_AGENT_APP_PORT=8091
LANGFUSE_PORT=3002
LOKI_PORT=3100

# 서비스 로그 파일 저장 경로 (Promtail이 읽는 경로와 일치해야 함)
LOG_DIR=C:/logs/internet-banking
PHOENIX_PORT=6006
PHOENIX_GRPC_PORT=4317
# Phoenix 계측 활성화 (true/false)
PHOENIX_ENABLED=false
# 추적으로 나가는 식별자의 가명처리 소금.
#
# 비우면 프로세스마다 임의 값으로 시작한다. 뚫리지는 않지만 **묶이지 않는다** —
# 재기동 전후도, 상담과 조사 에이전트 사이도 이어지지 않는다. 그러면 가명으로
# 바꾼 이유(같은 고객의 실행을 묶는 것)가 사라진다.
#
# 기본값을 코드에 박지 않는 이유는, 공개 저장소의 고정 소금은 알려진 소금이라
# 가명처리를 하지 않은 것과 같아지기 때문이다.
#   생성: python -c "import secrets; print(secrets.token_hex(32))"
AGENT_PII_SALT=
PHOENIX_GRPC_ENDPOINT=http://localhost:4317
# Java OTel Agent (auto-loan-review)
# JVM 실행 시 -javaagent:opentelemetry-javaagent.jar 추가
# 다운로드: https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

# ---- customer-service DB ----
CUSTOMER_DB_NAME=customer_db
CUSTOMER_DB_USER=customer
CUSTOMER_DB_PASSWORD=customer

# ---- core-banking DB (수신 deposit + 결제 payment 스키마를 한 DB 에 담는다) ----
# deposit_db / payment_db 로 나뉘어 있던 것을 core_banking 하나로 합쳤다.
# docs/decisions/core-banking-merge.md 참고.
CORE_BANKING_DB_NAME=core_banking
CORE_BANKING_DB_USER=core
CORE_BANKING_DB_PASSWORD=core

# ---- loan-service DB ----
LOAN_DB_NAME=loan_db
LOAN_DB_USER=loan
LOAN_DB_PASSWORD=loan


# ---- ai-db (auto-loan-review 전용) ----
AI_DB_NAME=ai_db
AI_DB_USER=ai
AI_DB_PASSWORD=ai

# ---- common account DB (공통 계좌 마스터. loan-service가 먼저 채택, 추후 deposit 전환) ----
COMMON_DB_NAME=common_db
COMMON_DB_USER=common
COMMON_DB_PASSWORD=common

# ---- Langfuse DB ----
LANGFUSE_DB_NAME=langfuse_db
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=langfuse
# 운영 환경에서는 반드시 변경 (openssl rand -base64 32)
LANGFUSE_SECRET=langfuse-secret-change-in-prod
LANGFUSE_SALT=langfuse-salt-change-in-prod
# Langfuse API Keys (프로젝트 Settings → API Keys에서 발급)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=http://localhost:3002

# ---- Redis ----
# docker-compose로 서비스를 컨테이너로 띄우는 경우 compose 서비스명 사용.
# 호스트에서 직접 bootRun 할 때는 localhost 로 덮어쓸 것.
REDIS_HOST=redis

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---- Alertmanager ----
# Slack Incoming Webhook URL (Grafana → Alerting → Contact points → Slack-DM 에서 복사)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# healthchecks.io 핑 URL (https://healthchecks.io 가입 후 체크 생성 시 발급)
HEALTHCHECKS_PING_URL=https://hc-ping.com/[UUID]

# ---- LLM API Keys ----
# consultation-service (OpenAI) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# auto-loan-review (Gemini) — https://aistudio.google.com/apikey
GEMINI_LOAN_PROVIDER=gemini-openai-compat
GEMINI_LOAN_MODEL=gemini-2.5-flash
GEMINI_LOAN_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
# review-ai-gateway (Claude) — https://console.anthropic.com
CLAUDE_API_KEY=

# ---- RAG Embed ----
RAG_EMBED_PROVIDER=openai
ADVISORY_RAG_EMBED_PROVIDER=openai
# Tesseract OCR 언어 데이터 경로 (각자 로컬 환경에 맞게 설정)
TESSDATA_PREFIX=

# ---- Payment Kafka Bootstrap ----
# 기본값: 내부 Kafka (kafka:29092) — 설정 없으면 자동 적용
# 외부 Kafka 연결 시 아래 주석 해제 후 payment-service 재시작
# KFTC_KAFKA_BOOTSTRAP=35.216.11.186:9094
# BOK_KAFKA_BOOTSTRAP=35.216.11.186:9094
# INTERNAL_KAFKA_BOOTSTRAP=35.216.11.186:9094

# ---- Crypto (AES-256, 32 bytes Base64) ----
CRYPTO_KEY_BASE64=

# ---- Schema Registry ----
SCHEMA_REGISTRY_URL=http://localhost:18081

# ---- Swagger / OpenAPI ----
# 운영 환경에서는 false 권장. 로컬·개발 환경 기본 true.
SWAGGER_ENABLED=true
# 접속 URL (서비스별)
#   customer-service : http://localhost:8081/swagger-ui.html
#   deposit-service  : http://localhost:8082/swagger-ui.html
#   loan-service     : http://localhost:8083/swagger-ui.html
#   payment-service  : http://localhost:8084/swagger-ui.html
#   master-service   : http://localhost:8085/swagger-ui.html
# OpenAPI 스펙(JSON)
#   http://localhost:<port>/v3/api-docs

# 게이트웨이 ↔ 상담 사이드카 공유 시크릿.
#
# 상담 서비스는 이 값이 맞아야 신원 헤더(X-Customer-Id 등)를 믿는다. 비어 있으면
# **아무 신원도 믿지 않아** 챗봇이 전부 401 이다 — fail-closed 라 조용히 뚫리지는
# 않지만, 값이 없다는 것도 알기 어렵다. 실제로 이 변수가 .env.sample 에 없어서
# 새로 받은 사람은 챗봇을 켤 수 없었다.
CONSULTATION_GATEWAY_SHARED_SECRET=change-me-local-only

# 게이트웨이 ↔ 조사 사이드카 공유 시크릿.
#
# 상담 쪽과 같은 구실이다. 조사 사이드카는 이 값이 맞아야 신원 헤더를 믿는다 —
# 비어 있으면 어드민의 조사 화면이 전부 403 이고, 이체가 막힌 고객이 받는
# 맞춤 안내(연령대별)도 조용히 기본형으로 내려간다.
FRAUD_GATEWAY_SHARED_SECRET=change-me-local-only

# 탐지기(fds-detector) → 조사 사이드카 인계 시크릿.
#
# **위 값과 다른 구실이다.** 게이트웨이 쪽은 "사람의 요청이 게이트웨이를 거쳐 왔다",
# 이쪽은 "기계가 직접 넘겼다" 를 뜻한다. 하나로 합치면 탐지기 시크릿을 아는 쪽이
# 사람 신원까지 위조할 수 있어 나눠 둔다.
#
# 비어 있으면 사후 탐지가 넘기는 사건이 전부 403 으로 되튄다 — 탐지는 도는데
# 조사 큐가 영원히 비어 있는 상태가 된다.
FRAUD_DISPATCH_SHARED_SECRET=change-me-local-only
